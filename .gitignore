# Data directory (never commit raw images; allow lightweight CSV split manifests)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/held_out_images.csv
!data/processed/vision_predictions.csv
!data/processed/cnn_splits/
!data/processed/cnn_splits/*.csv

# Saved model weights
models/*.pt
models/*.pth
models/*.pkl
models/*.joblib
!models/.gitkeep

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
