# Data directory (never commit raw or large processed datasets)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Saved model weights
models/*.pt
models/*.pth
models/*.pkl
models/*.joblib
!models/.gitkeep

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
